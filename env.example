# Provider: gemini
PROVIDER=gemini

# Gemini
GEMINI_API_KEY=AIzaSyCeaDA9dKx9jARJJnsG2PyM71ajiNuGIj0
GEMINI_MODEL=gemini-2.0-flash-exp

# Embeddings
TEXT_EMBEDDER=sentence-transformers/all-MiniLM-L6-v2
CLIP_EMBEDDER=openai/clip-vit-base-patch32

# Chroma persistence
CHROMA_DIR=./chroma_db

# SQLite for numeric facts
SQLITE_PATH=./facts.db

# RAG
TOP_K=5
MAX_TOKENS=600

# Logging
ENVIRONMENT=development
DEV_LOG_LEVEL=DEBUG
PROD_LOG_LEVEL=INFO
LOG_DIR=logs